# Скопировать в .env и заполнить перед запуском: docker compose up -d --build

# Порт API на сервере
HOST_PORT=8080

# База данных PostgreSQL
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=chat_bd

# Ключ шифрования сообщений (ровно 32 символа)
# Не менять — старые сообщения не расшифруются
ENCRYPTION_KEY=12345678901234567890123456789012

# Адреса фронтенда для CORS (через запятую)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Адрес сервера для Swagger (IP или домен и порт)
SWAGGER_HOST=localhost:8080
